{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/prod-ai", "permanent": false },
    {
      "source": "/:lesson(streaming|tokens|retrieval|caching|queues|batching|quality|playground)",
      "destination": "/prod-ai/:lesson",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/prod-ai/:path*", "destination": "/:path*" }
  ]
}
